{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "group:allNonMajor", ":semanticCommitTypeAll(chore)"],
	"timezone": "UTC",
	"labels": ["Dependencies"],
	"assignees": ["MoldyTaint"],
	"baseBranchPatterns": ["dev"],
	"automergeType": "pr",
	"packageRules": [
		{
			"description": "Schedule all dependency and CI updates to Monday mornings only",
			"matchManagers": ["npm", "github-actions"],
			"schedule": ["before 6am on Monday"]
		},
		{
			"description": "Automerge patch and minor npm updates after 3-day stability window",
			"matchUpdateTypes": ["patch", "minor"],
			"matchCurrentVersion": "!/^0/",
			"matchManagers": ["npm"],
			"automerge": true,
			"minimumReleaseAge": "3 days"
		},
		{
			"description": "Automerge GitHub Actions bumps after 7-day cooldown (supply-chain safety)",
			"matchManagers": ["github-actions"],
			"automerge": true,
			"minimumReleaseAge": "7 days",
			"pinDigests": true
		},
		{
			"description": "Keep major version bumps manual",
			"matchUpdateTypes": ["major"],
			"automerge": false
		},
		{
			"description": "better-auth 1.7 schema validation rejects our auth tables (apikey referenceId/configId drift, legacy userId) — frozen at 1.6.25 until the baseline DDL is reconciled with the plugin's expectations (see pin commit 26097734)",
			"matchPackageNames": ["better-auth", "@better-auth/api-key"],
			"allowedVersions": "1.6.25"
		}
	],
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 6am on Monday"]
	}
}
